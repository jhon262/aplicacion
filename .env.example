# Variables del backend (Hardhat, proxy IPFS y carga inicial de Firebase).
# Copiar como .env. No subir el .env a GitHub.

# Despliegue en redes de prueba (no hace falta para la red local 1337)
PRIVATE_KEY=
INFURA_API_KEY=
ETHERSCAN_KEY=
POLYGONSCAN_KEY=

# Billeteras de los docentes que reciben DOCENTE_ROLE al desplegar (separadas por coma).
# Si se deja vacío en la red local, se usan las cuentas #2, #3 y #4 de Hardhat.
DOCENTE_WALLETS=

# Pinata: el JWT queda solo en el servidor (server/ipfs-proxy.js o la función de Vercel api/ipfs).
# Nunca ponerlo con prefijo VITE_, porque Vite lo incrustaría en el código del navegador.
PINATA_JWT=
IPFS_PROXY_PORT=8787

# Carga inicial de cuentas ficticias en Firebase (scripts/seed-firebase.js)
GOOGLE_APPLICATION_CREDENTIALS=
SEED_PASSWORD=
